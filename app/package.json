{
  "name": "app",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "A Vite + React + wagmi dApp for the QoreChain EVM, with RainbowKit and the QoreX wallet.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "scan:live": "tsx scripts/scan-live.ts",
    "e2e": "tsx scripts/e2e.ts",
    "advise:live": "tsx scripts/advise-live.ts",
    "workflows": "tsx scripts/workflows.ts",
    "benchmark": "tsx scripts/benchmark.ts",
    "build:api": "node scripts/build-api.mjs",
    "ask:live": "tsx scripts/ask-live.ts"
  },
  "dependencies": {
    "@cosmjs/stargate": "^0.39.0",
    "@noble/curves": "^1.9.1",
    "@noble/hashes": "^1.8.0",
    "@qorechain/evm": "^0.14.0",
    "@qorechain/qorex-rainbowkit": "^0.1.0",
    "@qorechain/qorex-types": "^0.1.0",
    "@qorechain/sdk": "^0.14.0",
    "@rainbow-me/rainbowkit": "^2.2.11",
    "@scure/base": "^1.2.6",
    "@scure/bip32": "^1.7.0",
    "@tanstack/react-query": "^5.59.0",
    "cosmjs-types": "^0.11.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "viem": "~2.53.1",
    "wagmi": "^2.19.5",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.0",
    "playwright-core": "^1.49.1",
    "tsx": "^4.23.15",
    "typescript": "^5.6.3",
    "vite": "^5.4.0",
    "vitest": "^3.2.4"
  }
}
