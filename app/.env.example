# Copy to .env (gitignored). Never commit real keys.
# AI advisor (server-side only; without it the app shows the rule-based plan)
# Google Gemini key(s), comma separated — rotated on 401/403/429
GEMINI_API_KEYS=
ADVISOR_MODEL=gemini-3.5-flash
# Optional: WalletConnect project id for RainbowKit
VITE_WALLETCONNECT_PROJECT_ID=

# Scan API (optional): partner keys with a higher rate limit, comma separated; public origin for links
SCAN_API_KEYS=
PUBLIC_URL=

# Opt-in alerts (optional — the UI says "not switched on" until storage + one channel are set)
# Storage: Upstash Redis (Vercel Marketplace adds these)
KV_REST_API_URL=
KV_REST_API_TOKEN=
# Email via Resend
RESEND_API_KEY=
ALERTS_FROM=
# Telegram bot (create with @BotFather; webhook → https://<host>/api/alerts?action=telegram with this secret)
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
TELEGRAM_WEBHOOK_SECRET=
# Vercel Cron sends Authorization: Bearer CRON_SECRET to /api/alerts?action=cron (daily)
CRON_SECRET=
# Local only: ALERTS_DEV=1 → in-memory storage + console mailer on vite dev
ALERTS_DEV=
