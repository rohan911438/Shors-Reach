# Copy to .env (gitignored). Never commit real keys.
# AI advisor (server-side only; without it the app shows the rule-based plan)
# Google Gemini key(s), comma separated — rotated on 401/403/429
GEMINI_API_KEYS=
ADVISOR_MODEL=gemini-3.5-flash
# Optional: WalletConnect project id for RainbowKit
VITE_WALLETCONNECT_PROJECT_ID=
